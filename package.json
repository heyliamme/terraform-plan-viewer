{
  "name": "terraform-plan-viewer",
  "displayName": "Terraform Plan Viewer",
  "description": "Read a Terraform or OpenTofu plan in a minute: a summary, destructive changes first, before/after for each attribute, drift, outputs and checks. Opens plan JSON, binary .tfplan files and CI log output, colour codes and all.",
  "version": "0.1.0",
  "publisher": "heyliam",
  "license": "MIT",
  "icon": "media/icon.png",
  "galleryBanner": {
    "color": "#0f2326",
    "theme": "dark"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/heyliamme/terraform-plan-viewer"
  },
  "bugs": {
    "url": "https://github.com/heyliamme/terraform-plan-viewer/issues"
  },
  "homepage": "https://github.com/heyliamme/terraform-plan-viewer#readme",
  "qna": "https://github.com/heyliamme/terraform-plan-viewer/issues",
  "pricing": "Free",
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Visualization",
    "Other"
  ],
  "keywords": [
    "terraform",
    "opentofu",
    "tofu",
    "terraform plan",
    "tfplan",
    "plan viewer",
    "infrastructure as code",
    "iac",
    "hcl",
    "plan review"
  ],
  "main": "./dist/extension.js",
  "activationEvents": [
    "onLanguage:json",
    "onLanguage:plaintext",
    "onLanguage:log",
    "onLanguage:jsonc",
    "onLanguage:terraform-plan",
    "onLanguage:tfplan",
    "onCustomEditor:terraformPlanViewer.plan",
    "onWebviewPanel:terraformPlanViewer"
  ],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": "limited",
      "restrictedConfigurations": [
        "terraformPlanViewer.binaryPath",
        "terraformPlanViewer.planArgs"
      ],
      "description": "In Restricted Mode no Terraform or OpenTofu binary runs: binary .tfplan files can't be opened and Run Plan is unavailable. Plan JSON and text plans open as usual."
    },
    "virtualWorkspaces": {
      "supported": "limited",
      "description": "Opening a binary .tfplan and Run Plan need the plan's folder on a local disk."
    }
  },
  "contributes": {
    "customEditors": [
      {
        "viewType": "terraformPlanViewer.plan",
        "displayName": "Terraform Plan Viewer",
        "selector": [
          { "filenamePattern": "*.tfplan.json" },
          { "filenamePattern": "*.plan.json" },
          { "filenamePattern": "*.tfplan.txt" },
          { "filenamePattern": "*.plan.txt" },
          { "filenamePattern": "*.plan" },
          { "filenamePattern": "*.json" },
          { "filenamePattern": "*.txt" },
          { "filenamePattern": "*.log" }
        ],
        "priority": "option"
      },
      {
        "viewType": "terraformPlanViewer.binary",
        "displayName": "Terraform Plan Viewer",
        "selector": [
          { "filenamePattern": "*.tfplan" },
          { "filenamePattern": "tfplan" }
        ],
        "priority": "default"
      }
    ],
    "commands": [
      {
        "command": "terraformPlanViewer.open",
        "title": "Open as Terraform Plan",
        "category": "Terraform Plan",
        "icon": {
          "light": "media/title-light.svg",
          "dark": "media/title-dark.svg"
        }
      },
      {
        "command": "terraformPlanViewer.openFile",
        "title": "Open Plan File…",
        "category": "Terraform Plan"
      },
      {
        "command": "terraformPlanViewer.openClipboard",
        "title": "Open Plan from Clipboard",
        "category": "Terraform Plan"
      },
      {
        "command": "terraformPlanViewer.runPlan",
        "title": "Run Plan and Open…",
        "category": "Terraform Plan"
      },
      {
        "command": "terraformPlanViewer.compare",
        "title": "Compare with Another Plan…",
        "category": "Terraform Plan"
      },
      {
        "command": "terraformPlanViewer.compareSelected",
        "title": "Compare Terraform Plans",
        "category": "Terraform Plan"
      }
    ],
    "keybindings": [
      {
        "command": "terraformPlanViewer.open",
        "key": "ctrl+k t",
        "mac": "cmd+k t",
        "when": "!terminalFocus && terraformPlanViewer.isPlan"
      }
    ],
    "menus": {
      "commandPalette": [
        {
          "command": "terraformPlanViewer.compareSelected",
          "when": "false"
        },
        {
          "command": "terraformPlanViewer.open",
          "when": "activeEditor != 'WebviewEditor' && (terraformPlanViewer.isPlan || resourceExtname =~ /^\\.(log|txt)$/)"
        },
        {
          "command": "terraformPlanViewer.compare",
          "when": "terraformPlanViewer.isPlan && activeEditor != 'WebviewEditor' || activeCustomEditorId == 'terraformPlanViewer.plan' || activeCustomEditorId == 'terraformPlanViewer.binary'"
        },
        {
          "command": "terraformPlanViewer.runPlan",
          "when": "isWorkspaceTrusted && workspaceFolderCount > 0"
        }
      ],
      "explorer/context": [
        {
          "command": "terraformPlanViewer.open",
          "when": "!listMultiSelection && !explorerResourceIsFolder && (resourceExtname =~ /^\\.(tfplan|plan|log|txt)$/ || resourceFilename == tfplan || resourceFilename =~ /plan.*\\.json$/i || resourcePath in terraformPlanViewer.planFiles)",
          "group": "navigation@30"
        },
        {
          "command": "terraformPlanViewer.compareSelected",
          "when": "listMultiSelection && !explorerResourceIsFolder && (resourceExtname =~ /^\\.(json|txt|log|plan|tfplan)$/ || resourceFilename == tfplan)",
          "group": "3_compare@40"
        },
        {
          "command": "terraformPlanViewer.runPlan",
          "when": "explorerResourceIsFolder && isWorkspaceTrusted",
          "group": "2_workspace@90"
        }
      ],
      "editor/title": [
        {
          "command": "terraformPlanViewer.open",
          "when": "resourcePath in terraformPlanViewer.planFiles && activeEditor != 'WebviewEditor'",
          "group": "navigation@-9"
        }
      ],
      "editor/context": [
        {
          "command": "terraformPlanViewer.open",
          "when": "terraformPlanViewer.isPlan",
          "group": "3_compare@20"
        }
      ]
    },
    "configuration": {
      "title": "Terraform Plan Viewer",
      "properties": {
        "terraformPlanViewer.binaryPath": {
          "type": "string",
          "default": "",
          "markdownDescription": "The `terraform` or `tofu` binary used to read binary `.tfplan` files and to run plans: a name on your `PATH` or a full path. Empty: the binary the plan file was written by (`tofu` or `terraform`) is looked for on your `PATH`, then the other one. A user or machine setting only: a workspace can't set it. Nothing runs in Restricted Mode.",
          "scope": "machine"
        },
        "terraformPlanViewer.planArgs": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "markdownDescription": "Extra arguments for **Run Plan and Open…**, such as `-var-file=prod.tfvars`. One option per item, `-name=value`; the value can also be the next item after `-var`, `-var-file`, `-target`, `-replace`, `-exclude`, `-lock-timeout` or `-parallelism`. `-out`, `-chdir`, `-state`, `-state-out`, `-backup`, `-generate-config-out`, `-json` and `-input` are not allowed (the viewer sets the output and input itself). A user or machine setting only: a workspace can't set it.",
          "scope": "machine"
        },
        "terraformPlanViewer.maskSensitive": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "Show sensitive values as `(sensitive)` until you reveal them one by one. Copy as Markdown keeps them masked either way. A user setting only: a workspace can't turn masking off. When it is off, the view says so.",
          "scope": "application"
        },
        "terraformPlanViewer.destructiveFirst": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "List resources that are destroyed or replaced before the rest.",
          "scope": "resource"
        },
        "terraformPlanViewer.showUnchanged": {
          "type": "boolean",
          "default": false,
          "markdownDescription": "Also list resources the plan leaves alone (no-op), folded.",
          "scope": "resource"
        },
        "terraformPlanViewer.showTimeoutSeconds": {
          "type": "number",
          "default": 60,
          "minimum": 5,
          "maximum": 86400,
          "markdownDescription": "How long `terraform show -json` may take to read a binary plan before it is stopped.",
          "scope": "machine-overridable"
        },
        "terraformPlanViewer.planTimeoutSeconds": {
          "type": "number",
          "default": 900,
          "minimum": 10,
          "maximum": 86400,
          "markdownDescription": "How long **Run Plan and Open…** may take before it is stopped. You can also cancel it from the progress notification. A stopped plan is interrupted and given a minute to release the state lock; on Windows the plan runs with `-lock=false`.",
          "scope": "machine-overridable"
        }
      }
    }
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "watch": "node scripts/build.mjs --watch",
    "typecheck": "tsc --noEmit -p .",
    "test": "node scripts/build.mjs && node --test --test-concurrency=1 test/*.test.mjs",
    "package": "node scripts/build.mjs --prod && vsce package --no-dependencies",
    "test:e2e": "npm run package && node test/e2e/run.mjs"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/vscode": "^1.90.0",
    "@vscode/codicons": "0.0.36",
    "@vscode/vsce": "^4.0.0",
    "esbuild": "^0.28.2",
    "ovsx": "^1.3.0",
    "typescript": "^7.0.2"
  }
}
